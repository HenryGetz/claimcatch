direction: right
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
  }
}

classes: {
  node: {
    style: {
      fill: "#0F2537"
      stroke: "#2B7A8B"
      font-color: "#F8F7F4"
      stroke-width: 2
      border-radius: 6
      font-size: 28
    }
  }
  source: {
    style: {
      fill: "#F8F7F4"
      stroke: "#2B7A8B"
      font-color: "#0F2537"
      stroke-width: 2
      border-radius: 4
      font-size: 20
    }
  }
  human: {
    style: {
      fill: "#F8F7F4"
      stroke: "#2B7A8B"
      font-color: "#0F2537"
      stroke-width: 3
      border-radius: 6
      font-size: 26
    }
  }
  output: {
    style: {
      fill: "#0F2537"
      stroke: "#2B7A8B"
      font-color: "#F8F7F4"
      stroke-width: 2
      border-radius: 6
      font-size: 25
    }
  }
}

input: TPA Claim Packet {
  class: node
  formats: PDF · DOCX · UB-04 { class: source }
}
ocr: Mistral OCR 4.1 (ZDR) { class: node; link: "https://docs.mistral.ai/models/ocr-4-1" }
reasoning: Fireworks AI {
  class: node
  link: "https://docs.fireworks.ai/serverless/us-only-serverless"
  model: DeepSeek V4.1 Flash { class: source }
  zdr: ZDR · BAA { class: source }
}
verify: Ground-Truth Verification {
  class: node
  cms: CMS NCD 110.24 { class: source; link: "https://www.cms.gov/medicare-coverage-database/view/ncd.aspx?ncdid=374" }
  fda: openFDA { class: source; link: "https://open.fda.gov/" }
  court: CourtListener { class: source; link: "https://www.courtlistener.com/help/" }
  ecfr: eCFR Title 29 { class: source; link: "https://www.ecfr.gov/current/title-29" }
}
sanitizer: Zero-PHI Sanitizer {
  class: node
  rule: Keeps key + math { class: source }
}
human: Human Analyst Review & Sign-Off {
  class: human
  gate: Human gate before records or notices { class: source }
}
hubspot: HubSpot Claim {
  class: output
  link: "https://developers.hubspot.com/docs/guides/api/crm/objects/custom-objects"
  detail: "catastrophic_claim — Claimant key + math" { class: source }
}
finance: Draft Finance Tranche 1 Memo {
  class: output
  detail: "$1.70M wire — Requires Human Sign-Off" { class: source }
}
tpa: Draft TPA Cure Notice {
  class: output
  detail: "$250k hold — Pending Review" { class: source }
}

input -> ocr: Page-Anchored Markdown { style.stroke: "#2B7A8B"; style.font-color: "#0F2537"; style.font-size: 18 }
ocr -> reasoning { style.stroke: "#2B7A8B" }
reasoning <-> verify: Citations / rules { style.stroke: "#2B7A8B"; style.font-color: "#0F2537"; style.font-size: 18 }
reasoning -> sanitizer: Strips clinical text { style.stroke: "#2B7A8B"; style.font-color: "#0F2537"; style.font-size: 18 }
sanitizer -> human: key + math { style.stroke: "#2B7A8B"; style.font-color: "#0F2537"; style.font-size: 18 }
human -> hubspot { style.stroke: "#2B7A8B" }
human -> finance { style.stroke: "#2B7A8B" }
human -> tpa { style.stroke: "#2B7A8B" }
