direction: right
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
  }
}

classes: {
  node: {
    style: {
      fill: "#0F2537"
      stroke: "#2B7A8B"
      font-color: "#F8F7F4"
      stroke-width: 2
      border-radius: 6
      font-size: 28
    }
  }
  source: {
    style: {
      fill: "#F8F7F4"
      stroke: "#2B7A8B"
      font-color: "#0F2537"
      stroke-width: 2
      border-radius: 4
      font-size: 20
    }
  }
  output: {
    style: {
      fill: "#0F2537"
      stroke: "#2B7A8B"
      font-color: "#F8F7F4"
      stroke-width: 2
      border-radius: 6
      font-size: 27
    }
  }
}

input: TPA Claim Packet {
  class: node
  formats: PDF · DOCX · UB-04 { class: source }
}
ocr: Mistral OCR 4.1 (ZDR) { class: node }
reasoning: Fireworks AI {
  class: node
  model: DeepSeek V4.1 Flash { class: source }
  zdr: ZDR · BAA { class: source }
}
mcp: Ground-Truth MCP Layer {
  class: node
  cms: CMS NCD 110.24 { class: source }
  fda: openFDA { class: source }
  court: CourtListener ERISA { class: source }
  ecfr: eCFR Title 29 { class: source }
}
sanitizer: Zero-PHI Sanitizer {
  class: node
  rule: Keeps key + math { class: source }
}
hubspot: HubSpot catastrophic_claim { class: output }
growth: Growth Expansion Signal {
  class: output
  broker: Lockton / TPA { class: source }
}
finance: Finance Tranche 1 Wire { class: output }
tpa: TPA Cure Notice { class: output }

input -> ocr: Page-Anchored .md {
  style.stroke: "#2B7A8B"
  style.font-color: "#0F2537"
  style.font-size: 18
}
ocr -> reasoning {
  style.stroke: "#2B7A8B"
}
reasoning <-> mcp {
  style.stroke: "#2B7A8B"
}
reasoning -> sanitizer: "Strips clinical text" {
  style.stroke: "#2B7A8B"
  style.font-color: "#0F2537"
  style.font-size: 18
}
sanitizer -> hubspot: Claimant key + math {
  style.stroke: "#2B7A8B"
  style.font-color: "#0F2537"
  style.font-size: 17
}
sanitizer -> growth: Laser shock {
  style.stroke: "#2B7A8B"
  style.font-color: "#0F2537"
  style.font-size: 17
}
sanitizer -> finance: "\$1.70M wire" {
  style.stroke: "#2B7A8B"
  style.font-color: "#0F2537"
  style.font-size: 17
}
sanitizer -> tpa: "\$250k hold" {
  style.stroke: "#2B7A8B"
  style.font-color: "#0F2537"
  style.font-size: 17
}
